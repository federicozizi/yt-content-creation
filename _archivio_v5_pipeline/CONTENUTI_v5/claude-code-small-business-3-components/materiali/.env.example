# ⚠️ Italian twin: CONTENUTI/claude-code-piccoli-business-3-componenti/materiali/.env.example
#
# Copy this file to `.env` and fill in your real values.
# DO NOT commit `.env` (it's already in .gitignore).
#
# These credentials are ONLY for the Supabase MCP connector.
# The Claude for Small Business package (Step 2) is configured inside Cowork,
# not here — Anthropic handles the OAuth flows for you.

# === Supabase ===
# Project URL: Supabase dashboard → Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Service Role Key: Supabase dashboard → Settings → API → service_role (secret)
# ⚠️ WARNING: this key grants FULL DB access (bypasses RLS).
# Never share it, never commit it, never show it on camera.
# For production environments consider using the anon key + strict RLS policies.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
