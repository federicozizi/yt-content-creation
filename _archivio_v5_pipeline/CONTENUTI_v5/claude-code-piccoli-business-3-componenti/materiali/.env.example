# ⚠️ Gemello inglese: CONTENUTI/claude-code-small-business-3-components/materiali/.env.example
#
# Copia questo file in `.env` e compila coi tuoi valori reali.
# NON committare `.env` (è già in .gitignore).
#
# Queste credenziali servono SOLO al connettore MCP di Supabase.
# Il pacchetto Claude for Small Business (Step 2) si configura dentro Cowork,
# non qui — Anthropic gestisce gli OAuth per te.

# === Supabase ===
# Project URL: pannello Supabase → Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Service Role Key: pannello Supabase → Settings → API → service_role (segreto)
# ⚠️ ATTENZIONE: questa chiave dà accesso TOTALE al DB (bypassa RLS).
# Non condividerla mai, non committarla, non mostrarla a video.
# Per ambienti di produzione valuta di usare la anon key + politiche RLS strette.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
