# Credenziali per team_agenti.py
# Copia questo file in .env (cp .env.example .env) e compila i valori reali.
# IL FILE .env NON VA MAI COMMITATO IN REPO PUBBLICI.

# Chiave API Anthropic (genera su console.anthropic.com → Settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Gmail per invio del brief via SMTP
# Serve 2FA attiva + app password generata su myaccount.google.com/apppasswords
GMAIL_USER=tuo-account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Indirizzo che riceve il brief ogni mattina (può essere uguale a GMAIL_USER)
BRIEF_RECIPIENT=tuoindirizzo@gmail.com
