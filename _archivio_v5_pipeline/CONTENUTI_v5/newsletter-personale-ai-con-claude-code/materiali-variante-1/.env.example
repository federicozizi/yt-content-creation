# Copia questo file in `.env` e compila i valori reali.
# NON committare `.env` (è già in .gitignore).

# API key Anthropic — la trovi su https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Modello da usare (default: claude-sonnet-4-7)
ANTHROPIC_MODEL=claude-sonnet-4-7
