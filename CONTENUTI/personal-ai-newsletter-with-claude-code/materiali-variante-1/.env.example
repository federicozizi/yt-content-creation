# Copy this file to `.env` and fill in the real values.
# DO NOT commit `.env` (it's already in .gitignore).

# Anthropic API key — find it at https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Model to use (default: claude-sonnet-4-7)
ANTHROPIC_MODEL=claude-sonnet-4-7
