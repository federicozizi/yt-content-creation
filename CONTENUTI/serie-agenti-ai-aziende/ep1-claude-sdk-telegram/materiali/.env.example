# Copia questo file e rinominalo in ".env" (senza .example), poi compila i valori.
# NON committare mai il file .env vero su GitHub. Vedi DISCLAIMER.md.

# Chiave personale Anthropic (la "chiave che sblocca Claude").
# La ottieni da https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=<incolla-qui-la-tua-chiave-anthropic>

# Token del bot Telegram (lo da' @BotFather su Telegram quando crei il bot).
TELEGRAM_BOT_TOKEN=<incolla-qui-il-token-del-bot-telegram>
