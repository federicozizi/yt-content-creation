# === SEGRETI: mai committare credenziali reali (regola globale, tutte le cartelle) ===
# Ignora ogni file di credenziali in QUALSIASI sottocartella.
# I file .env.example / .env.sample (solo placeholder) restano tracciati apposta.
.env
.env.*
!.env.example
!.env.sample
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
*.pem
*.key
secrets.json
service-account*.json

# Credenziali OAuth Google (legacy)
credentials.json
token.json

# Python
__pycache__/
*.pyc

# Claude Code — stato locale macchina (i permessi shared vanno in settings.json)
.claude/settings.local.json

# Dashboard locale "idee del giorno" generata dall'avviso all'accensione (rigenerata ogni volta)
dashboard-oggi.html
